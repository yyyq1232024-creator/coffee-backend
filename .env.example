# DeepSeek coffee consultant. Never expose this value through VITE_* variables.
DEEPSEEK_API_KEY="replace-with-a-new-key"
DEEPSEEK_MODEL="deepseek-flash"

# Supabase PostgreSQL session-pooler connection string. Required in every environment.
# Keep this server-side only and never expose it through a VITE_* variable.
DATABASE_URL="postgresql://postgres.project-ref:password@pooler-host:5432/postgres"
DB_POOL_SIZE="5"

# Persistent login lifetime. Sessions are stored as token hashes in PostgreSQL.
SESSION_TTL_DAYS="30"

PORT="3000"
