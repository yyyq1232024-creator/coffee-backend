# DeepSeek coffee consultant. Never expose this value through VITE_* variables.
DEEPSEEK_API_KEY="replace-with-a-new-key"
DEEPSEEK_MODEL="deepseek-flash"

# Production MySQL. Without DB_HOST the app falls back to coffee-shop-db.json,
# which is suitable for local development but not durable on ephemeral hosts.
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD="replace-with-database-password"
DB_NAME="coffee_shop"

PORT="3000"
